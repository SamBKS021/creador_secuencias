{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Creador de Secuencias",
  "version": "0.1.13",
  "identifier": "com.samuel.creadordesecuencias",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Creador de Secuencias",
        "width": 1480,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "maximized": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/SamBKS021/creador_secuencias/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2MDc2RDM2MTU2OTk2MzcKUldRM2xta1ZObTBIcHBBdUtjTXFpWEJDdWlPZmNSL2FIUHpETW9XNzNxVDVjNHZIMVBGeWllUEMK"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "oauth.defaults.json"
    ],
    "targets": "all",
    "createUpdaterArtifacts": false
  }
}
