{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Creador de Secuencias",
  "version": "0.1.0",
  "identifier": "com.samuel.creadordesecuencias",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Creador de Secuencias",
        "width": 1480,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "maximized": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true
  }
}
